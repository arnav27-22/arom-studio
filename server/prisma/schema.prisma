generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SUPPORT
  VIEWER
}

enum LeadStatus {
  NEW
  VIEWED
  RESPONDED
  ARCHIVED
}

enum InvoiceStatus {
  PAID
  PENDING
  OVERDUE
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  IN_REVIEW
  LAUNCHED
  ARCHIVED
}

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
}

enum AgreementStatus {
  PENDING
  SIGNED
}

enum PaymentStatus {
  PAID
  PENDING
  OVERDUE
}

enum DeviceType {
  DESKTOP
  MOBILE
  TABLET
}

enum AIConversationStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum NotificationType {
  INQUIRY
  PROPOSAL
  PAYMENT
  APPROVAL
  LIVE
  HANDOVER
  ALERT
}

enum LogSeverity {
  INFO
  WARN
  ERROR
}

enum RecycleCollection {
  VISITORS
  PDFS
  LEADS
  CLIENTS
  PROJECTS
  PROPOSALS
  AGREEMENTS
  PAYMENTS
  BLOGS
}

model Admin {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  role      AdminRole @default(ADMIN)
  passwordHash String
  isActive  Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  auditLogs    AuditLog[]
  sessions     AdminSession[]
  recycleActions RecycleBin[] @relation("RecycleActions")

  @@index([email])
  @@index([role])
}

model AdminSession {
  id        String   @id @default(cuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([adminId])
  @@index([expiresAt])
}

model Visitor {
  id              String     @id @default(cuid())
  sessionId       String?
  page            String     @default("/")
  entryPage       String?
  exitPage        String?
  deviceType      DeviceType @default(DESKTOP)
  deviceLabel     String?
  deviceBrand     String?
  network         String?
  browser         String     @default("Chrome")
  os              String?
  country         String     @default("")
  city            String?
  ip              String?
  referrer        String     @default("Direct")
  timeOnPage      Int        @default(30)
  sessionDuration Int?
  scrollDepth     Int        @default(0)
  pageViewsCount  Int        @default(1)
  isReturning     Boolean    @default(false)
  isBounce        Boolean    @default(false)
  isAutoGenerated Boolean    @default(false)
  metadata        Json?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  @@index([sessionId])
  @@index([page])
  @@index([country])
  @@index([createdAt])
  @@index([deviceType])
}

model VisitorSession {
  id            String   @id @default(cuid())
  sessionId     String   @unique
  entryPage     String?
  referrer      String?
  deviceType    DeviceType?
  browser       String?
  os            String?
  country       String?
  city          String?
  pageViews     Int      @default(0)
  totalDuration Int      @default(0)
  isBounce      Boolean  @default(false)
  startedAt     DateTime @default(now())
  lastActivityAt DateTime @default(now())
  endedAt       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sessionId])
  @@index([startedAt])
  @@index([lastActivityAt])
}

model GeneratedPDF {
  id          String   @id @default(cuid())
  pdfType     String   @default("Document")
  title       String   @default("PDF Document")
  clientName  String   @default("Client")
  clientEmail String?
  fileSizeKb  Int      @default(0)
  deviceType  String?
  browser     String?
  os          String?
  pdfDataUrl  String?
  storageUrl  String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([createdAt])
  @@index([pdfType])
  @@index([clientName])
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  service   String?
  budget    String?
  message   String?
  status    LeadStatus @default(NEW)
  country   String?
  metadata  Json?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model AIConversation {
  id            String               @id @default(cuid())
  visitorId     String
  title         String               @default("New Chat")
  messages      AIMessage[]
  device        String               @default("Desktop")
  browser       String               @default("Chrome")
  status        AIConversationStatus @default(ACTIVE)
  metadata      Json?
  createdAt     DateTime             @default(now())
  lastActiveAt  DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  deletedAt     DateTime?

  @@index([visitorId])
  @@index([createdAt])
  @@index([status])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String
  text           String
  timestamp      DateTime       @default(now())

  @@index([conversationId])
  @@index([timestamp])
}

model AIKnowledge {
  id                String   @id @default(cuid())
  category          String?
  title             String?
  question          String
  alternateQuestions Json?
  synonyms          Json?
  keywords          Json?
  description       String?
  detailedAnswer    String?
  shortAnswer       String?
  answer            String?
  relatedTopics     Json?
  navigationLinks   Json?
  tags              Json?
  priority          Int      @default(0)
  language          String   @default("en")
  version           String   @default("1.0")
  status            String   @default("Active")
  author            String?
  source            String?
  searchScore       Int?
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  @@index([category])
  @@index([status])
  @@index([question])
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  service   String?
  budget    String?
  message   String
  agreedToTerms Boolean @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([email])
  @@index([createdAt])
}

model DiscoveryForm {
  id                    String   @id @default(cuid())
  fullName              String
  company               String
  email                 String
  phone                 String?
  website               String?
  budget                String?
  urgency               String?
  preferredLaunchDate   String?
  contentProvider       String?
  status                String   @default("New")
  pdfDataUrl            String?
  fullData              Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deletedAt             DateTime?

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique
  clientName     String
  clientEmail    String
  clientPhone    String?
  clientCompany  String?
  currency       String        @default("INR")
  items          Json
  taxRate        Float         @default(0)
  discountRate   Float         @default(0)
  subtotal       Float
  taxAmount      Float         @default(0)
  discountAmount Float         @default(0)
  totalAmount    Float
  status         InvoiceStatus @default(PENDING)
  dueDate        DateTime
  notes          String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  @@index([invoiceNumber])
  @@index([clientEmail])
  @@index([status])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  link      String?
  metadata  Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([type])
  @@index([read])
  @@index([createdAt])
}

model AuditLog {
  id         String       @id @default(cuid())
  adminId    String?
  admin      Admin?       @relation(fields: [adminId], references: [id])
  action     String
  module     String
  resourceId String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  country    String?
  sessionId  String?
  reason     String?
  success    Boolean      @default(true)
  severity   LogSeverity  @default(INFO)
  metadata   Json?
  createdAt  DateTime     @default(now())

  @@index([adminId])
  @@index([action])
  @@index([module])
  @@index([createdAt])
  @@index([severity])
}

model RecycleBin {
  id                 String           @id @default(cuid())
  originalCollection RecycleCollection
  itemData           Json
  title              String
  subtitle           String?
  deletedBy          String?
  deletedByName      String?
  originalCreatedAt  DateTime?
  deletedAt          DateTime         @default(now())
  restoredAt         DateTime?

  adminId    String?
  admin      Admin?  @relation("RecycleActions", fields: [adminId], references: [id])

  @@index([originalCollection])
  @@index([deletedAt])
}

model LinkClick {
  id         String   @id @default(cuid())
  url        String
  type       String?
  label      String?
  visitorId  String?
  page       String?
  sessionId  String?
  browser    String?
  country    String?
  referrer   String?
  utmSource  String?
  utmMedium  String?
  utmCampaign String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([url])
  @@index([type])
  @@index([createdAt])
  @@index([page])
}

model File {
  id          String   @id @default(cuid())
  originalName String
  mimeType    String
  size        Int
  storageUrl  String
  uploadedBy  String?
  module      String?
  resourceId  String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([module])
  @@index([resourceId])
}

model Asset {
  id              String   @id @default(cuid())
  clientName      String
  projectName     String
  googleDriveLink String
  folderStatus    String   @default("Needs Files")
  missingFilesCount Int    @default(0)
  uploadDate      String?
  checklist       Json?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([clientName])
}

model ProjectTimeline {
  id               String   @id @default(cuid())
  projectName      String
  clientName       String
  currentPhase     String
  estimatedDelivery String?
  timelineProgress Int      @default(0)
  upcomingTasks    Json?
  completedTasks   Json?
  delayedTasks     Json?
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  @@index([projectName])
}

model Feedback {
  id                  String   @id @default(cuid())
  clientName          String
  company             String?
  rating              Int
  review              String?
  testimonialApproved Boolean  @default(false)
  portfolioPermission Boolean  @default(false)
  clientSuggestions   String?
  metadata            Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  @@index([clientName])
}

model DesignApproval {
  id           String   @id @default(cuid())
  projectName  String
  clientName   String
  status       String   @default("Waiting Approval")
  approvalDate DateTime?
  previewUrl   String?
  comments     Json?
  version      String?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@index([projectName])
}

model Payment {
  id               String        @id @default(cuid())
  invoiceNumber    String?
  clientName       String
  amount           Float
  dueDate          DateTime
  paidDate         DateTime?
  status           PaymentStatus @default(PENDING)
  invoiceLink      String?
  receiptUrl       String?
  paymentMethod    String?
  reminderSentCount Int          @default(0)
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  @@index([invoiceNumber])
  @@index([clientName])
  @@index([status])
}

model Proposal {
  id              String         @id @default(cuid())
  proposalNumber  String         @unique
  clientName      String
  clientEmail     String
  title           String
  amount          Float
  status          ProposalStatus @default(DRAFT)
  validUntil      DateTime
  downloadUrl     String?
  scopeSummary    String?
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  @@index([proposalNumber])
  @@index([clientEmail])
  @@index([status])
}

model Agreement {
  id                String          @id @default(cuid())
  agreementNumber   String          @unique
  clientName        String
  clientEmail       String
  status            AgreementStatus @default(PENDING)
  agreementVersion  String          @default("1.0")
  signedDate        DateTime?
  downloadUrl       String?
  metadata          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  @@index([agreementNumber])
  @@index([clientEmail])
  @@index([status])
}

model Client {
  id                 String   @id @default(cuid())
  companyName        String
  contactPerson      String
  email              String   @unique
  phone              String?
  website            String?
  activeProjectsCount Int     @default(0)
  status             String   @default("Active")
  totalRevenue       Float    @default(0)
  notes              String?
  timeline           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  @@index([email])
  @@index([companyName])
  @@index([status])
}

model Project {
  id              String         @id @default(cuid())
  title           String
  clientId        String?
  clientName      String
  status          ProjectStatus  @default(PLANNING)
  progress        Int            @default(0)
  startDate       DateTime?
  dueDate         DateTime?
  completionDate  DateTime?
  priority        String         @default("Medium")
  assignedTeam    Json?
  projectFiles    Json?
  milestones      Json?
  launchStatus    String         @default("Pending")
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  @@index([clientId])
  @@index([status])
  @@index([title])
}

model ContentCollection {
  id                  String   @id @default(cuid())
  clientName          String
  projectName         String
  status              String   @default("Pending")
  completionPercentage Int     @default(0)
  downloadUrl         String?
  checklist           Json?
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())
  deletedAt           DateTime?

  @@index([clientName])
  @@index([projectName])
}

model Handover {
  id                   String   @id @default(cuid())
  projectName          String
  clientName           String
  status               String   @default("Ready")
  downloadZipUrl       String?
  githubLink           String?
  adminLoginUrl        String?
  adminUsername        String?
  domain               String?
  hosting              String?
  warrantyPeriodMonths Int      @default(12)
  supportExpiryDate    DateTime?
  handoverDate         DateTime?
  metadata             Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  deletedAt            DateTime?

  @@index([projectName])
  @@index([clientName])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  category  String   @default("general")
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([category])
}

model Blog {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String?
  content   String?
  category  String?
  readTime  String?
  author    Json?
  date      DateTime?
  tags      Json?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([slug])
  @@index([category])
  @@index([published])
}

model StatSnapshot {
  id        String   @id @default(cuid())
  type      String
  data      Json
  period    String
  recordedAt DateTime @default(now())

  @@index([type])
  @@index([period])
  @@index([recordedAt])
}
