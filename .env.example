# AROM Studio — Environment Variables
# Copy this to .env and fill in your values

# Site
VITE_SITE_URL=http://localhost:5173

# Contact
VITE_CONTACT_EMAIL=aromstudio27@gmail.com
VITE_WHATSAPP_NUMBER=918767990061

# EmailJS (required for contact form)
# Get your keys at https://www.emailjs.com
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Analytics (optional)
VITE_GA_ID=
VITE_CLARITY_ID=

# reCAPTCHA (optional)
VITE_RECAPTCHA_SITE_KEY=

# Server Configuration
PORT=3001
NODE_ENV=development

# Admin Authentication
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=

# Database (PostgreSQL via Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/arom_studio

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379
